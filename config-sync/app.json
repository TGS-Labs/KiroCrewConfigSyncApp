{
  "name": "config-sync",
  "version": "0.1.0",
  "displayName": "Config Sync",
  "description": "A Kiro Crew app: Config Sync",
  "author": "developer",
  "iconPath": "assets/icon.png",
  "defaultEnabled": false,
  "agents": [],
  "skills": ["skills/complete-pr-handoff"],
  "tags": [],
  "permissions": {
    "api": ["/apps/config-sync/api"]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health"
  },
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/config-sync",
        "label": "Config Sync",
        "icon": "Package"
      }
    ]
  },
  "crons": [
    {
      "name": "config-sync-push",
      "every": 900,
      "command": "cd \"$HOME/.kiro/crew/apps/config-sync\" && python3 -m backend.push",
      "enabled": false,
      "silent": true
    },
    {
      "name": "config-sync-poll",
      "every": 900,
      "command": "cd \"$HOME/.kiro/crew/apps/config-sync\" && python3 -m backend.poll",
      "enabled": false,
      "silent": false
    }
  ]
}
